PORT=5000

SUPABASE_URL=https://<your-project-ref>.supabase.co
# Server only. Never put this key in the client.
SUPABASE_SERVICE_ROLE_KEY=
# Used only if the service role key is not set.
SUPABASE_ANON_KEY=

# Password for the admin panel, and a long random string used to sign admin sessions
# (for example: openssl rand -base64 48).
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
